PORT=8080
# Separe mais de uma origem com vírgula. Vazio permite qualquer origem.
ALLOWED_ORIGINS=https://seu-site.netlify.app,http://localhost:5173
# Tempo para reservar a vaga de quem perdeu a conexão (milissegundos).
ROOM_TTL_MS=1800000
# Necessário para fotos/GIFs já reduzidos pelo frontend.
MAX_MESSAGE_BYTES=1500000
# Histórico guardado por sala. O limite de tamanho evita um arquivo excessivo.
CHAT_HISTORY_LIMIT=100
CHAT_HISTORY_MAX_CHARS=6291456
# Opcional: caminho de um disco persistente para manter salas após reiniciar.
# DATA_DIR=/var/data/encontro-jasmym
